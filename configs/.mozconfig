# AMD Ryzen 5 5600H Optimized MOZCONFIG
# For Ubuntu 26.04 with Zen 3 architecture

mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-firefox
ac_add_options --enable-application=browser

# CPU Optimizations via environment
export CFLAGS="-march=znver3 -O3 -pipe -fno-plt -ffast-math"
export CXXFLAGS="-march=znver3 -O3 -pipe -fno-plt -ffast-math"

# Build settings
ac_add_options --enable-optimize
ac_add_options --disable-debug
ac_add_options --disable-tests
ac_add_options --enable-lto=thin

# Telemetry removal - handled via about:config when using pre-built Firefox
# For source builds, telemetry can be disabled at runtime

# Legacy backend removal
ac_add_options --disable-glx
ac_add_options --disable-pulse
ac_add_options --disable-gstreamer

# Keep essential features
ac_add_options --enable-rust
ac_add_options --enable-webrtc
